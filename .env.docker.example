# Copie para .env.docker. Gere valores com: openssl rand -hex 32
POSTGRES_USER=underleaf
POSTGRES_DB=underleaf
POSTGRES_PASSWORD=#openssl rand -hex 32
BETTER_AUTH_SECRET=#openssl rand -hex 32

# URL pública, sem barra final; em produção use o domínio HTTPS.
APP_URL=http://localhost:8080
PUBLIC_PORT=8080
# Permite o download inicial dos pacotes LaTeX (milissegundos).
TECTONIC_TIMEOUT_MS=300000

# Opcional: aplicativo OAuth Mendeley.
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=
# Ao habilitar: http://localhost:8080/api/references/mendeley/callback
