{
  "name": "underleaf",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev:backend": "bun --filter '@underleaf/backend' dev",
    "dev:frontend": "bun --filter '@underleaf/frontend' dev",
    "build": "bun --filter '*' build",
    "format": "bun --filter '*' format",
    "lint": "bun --filter '*' lint"
  }
}
