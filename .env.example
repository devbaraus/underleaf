# Banco de Dados PostgreSQL
POSTGRES_USER=underleaf
POSTGRES_PASSWORD=underleaf
POSTGRES_DB=underleaf
POSTGRES_PORT=5432
DATABASE_URL=postgresql://underleaf:underleaf@localhost:5432/underleaf?schema=public

# Backend ElysiaJS
PORT=3333
BACKEND_PORT=3333
NODE_ENV=development
BETTER_AUTH_SECRET=underleaf-secret-dev-token-change-in-production-123456789
BETTER_AUTH_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3000,http://localhost:3333
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Frontend TanStack Start
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3333
INTERNAL_API_URL=http://localhost:3333

# Importação Mendeley (registre um aplicativo no portal de desenvolvedores)
FRONTEND_URL=http://localhost:3000
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=http://localhost:3333/api/references/mendeley/callback
