{
  "name": "@underleaf/backend",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --bun run --watch src/index.ts",
    "build": "bun run db:generate && bun build --compile --minify-whitespace --minify-syntax --target bun --outfile dist/server src/index.ts",
    "start": "bun run src/index.ts",
    "db:migrate:reset": "bun --env-file ../../.env --bun prisma migrate reset",
    "db:migrate:dev": "bun --env-file ../../.env --bun prisma migrate dev",
    "db:migrate:deploy": "bun --env-file ../../.env --bun prisma migrate deploy",
    "db:generate": "bun --env-file ../../.env --bun prisma generate",
    "db:studio": "bun --env-file ../../.env --bun prisma studio",
    "db:seed": "bun --env-file ../../.env --bun prisma/seed.ts",
    "db:push": "bun --env-file ../../.env --bun prisma db push",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.3",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "archiver": "^7.0.1",
    "better-auth": "^1.7.3",
    "consola": "^3.4.2",
    "elysia": "latest",
    "lib0": "^0.2.119",
    "logixlysia": "^6.8.1",
    "pg": "^8.23.0",
    "prisma-zod-generator": "^3.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "bun-types": "latest",
    "openapi-types": "^12.1.3",
    "prisma": "7.10.0",
    "typescript": "^5.7.3"
  }
}
